[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart Type / Add to Cart Behavior",
        "options": [
          {
            "value": "drawer",
            "label": "Open Slide-out Cart Drawer"
          },
          {
            "value": "page",
            "label": "Redirect to Cart Page"
          }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Live Chat",
    "settings": [
      {
        "type": "header",
        "content": "Tawk.to Live Chat"
      },
      {
        "type": "checkbox",
        "id": "enable_tawkto",
        "label": "Enable Tawk.to Live Chat",
        "default": true,
        "info": "Toggle on/off the Tawk.to live chat widget across the storefront."
      },
      {
        "type": "text",
        "id": "tawkto_property_id",
        "label": "Tawk.to Property/Widget Path",
        "default": "6a7c9995b02fd41d4c903642/1jvrbft1u",
        "info": "Property ID / Widget Path from your Tawk.to embed code."
      }
    ]
  }
]
