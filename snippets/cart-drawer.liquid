{% comment %}
  Modern Responsive Slide-out Cart Drawer
  Renders cart items and dynamic configurator line item properties
{% endcomment %}

<style>
  .cart-drawer-container,
  cart-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .cart-drawer-container[data-open="true"],
  .cart-drawer-container.active,
  .cart-drawer-container.is-active,
  cart-drawer[data-open="true"],
  cart-drawer.active,
  cart-drawer.is-active {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .cart-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cart-drawer-container[data-open="true"] .cart-drawer__overlay,
  .cart-drawer-container.active .cart-drawer__overlay,
  cart-drawer[data-open="true"] .cart-drawer__overlay,
  cart-drawer.active .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer__inner {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 440px;
    height: 100%;
    background: #ffffff;
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }

  .cart-drawer-container[data-open="true"] .cart-drawer__inner,
  .cart-drawer-container.active .cart-drawer__inner,
  cart-drawer[data-open="true"] .cart-drawer__inner,
  cart-drawer.active .cart-drawer__inner {
    transform: translateX(0) !important;
  }

  .cart-drawer__header {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .cart-drawer__title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-drawer__count {
    font-size: 0.95rem;
    font-weight: 600;
    color: #64748b;
  }

  .cart-drawer__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    color: #475569;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cart-drawer__close:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
  }

  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .cart-drawer__empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin: 1rem 0 0.5rem;
  }

  .cart-drawer__empty-subtext {
    font-size: 0.9rem;
    color: #64748b;
    margin-bottom: 1.5rem;
  }

  .cart-drawer__item {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-drawer__item-media {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }

  .cart-drawer__item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cart-drawer__item-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
    line-height: 1.35;
  }

  .cart-drawer__item-title:hover {
    color: #2563eb;
  }

  .cart-drawer__item-variant {
    font-size: 0.8rem;
    color: #64748b;
  }

  .cart-drawer__config-box {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.55rem 0.75rem;
    margin: 0.35rem 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cart-drawer__config-title {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
    margin-bottom: 0.15rem;
  }

  .cart-drawer__config-row {
    font-size: 0.8rem;
    line-height: 1.45;
    color: #0f172a;
  }

  .cart-drawer__config-row strong {
    font-weight: 700;
    color: #0f172a;
  }

  .cart-drawer__item-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.4rem;
  }

  .cart-drawer__item-price {
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__item-price .price-main {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
  }

  .cart-drawer__item-price .price-base {
    font-size: 0.725rem;
    color: #64748b;
  }

  .cart-drawer__item-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
  }

  .quantity-btn {
    width: 28px;
    height: 28px;
    background: #f8fafc;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .quantity-btn:hover {
    background: #e2e8f0;
  }

  .quantity-input {
    width: 32px;
    height: 28px;
    border: none;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: #0f172a;
    -moz-appearance: textfield;
  }

  .quantity-input::-webkit-outer-spin-button,
  .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-drawer__item-remove {
    background: transparent;
    border: none;
    color: #ef4444;
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background 0.15s ease;
  }

  .cart-drawer__item-remove:hover {
    background: #fef2f2;
  }

  .cart-drawer__footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .cart-drawer__footer-totals {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .cart-drawer__footer-label {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
  }

  .cart-drawer__footer-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0f172a;
  }

  .cart-drawer__tax-note {
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 1rem;
  }

  .cart-drawer__checkout-btn {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    background: #0f172a;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.1s ease;
  }

  .cart-drawer__checkout-btn:hover {
    background: #1e293b;
  }

  @media (max-width: 480px) {
    .cart-drawer__inner {
      max-width: 100vw;
    }
    .cart-drawer__body {
      padding: 1rem;
    }
    .cart-drawer__footer {
      padding: 1rem;
    }
  }
</style>

<div class="cart-drawer-container" id="CartDrawerContainer">
  <div class="cart-drawer__overlay" id="CartDrawerOverlay"></div>
  
  <div class="cart-drawer__inner" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Shopping Cart">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">
        Shopping Cart
        <span class="cart-drawer__count" id="CartDrawerCount">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="cart-drawer__close" id="CartDrawerClose" aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="cart-drawer__body" id="CartDrawerBody">
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty">
          <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <h3 class="cart-drawer__empty-title">Your cart is empty</h3>
          <p class="cart-drawer__empty-subtext">Looks like you haven't added anything to your cart yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="display:inline-block; padding:0.75rem 1.5rem; text-decoration:none; border-radius:6px; font-weight:700;">
            Start Shopping
          </a>
        </div>
      {% else %}
        <div class="cart-drawer__items" id="CartDrawerItems">
          {% for item in cart.items %}
            <div class="cart-drawer__item" data-line-item-key="{{ item.key }}">
              <div class="cart-drawer__item-media">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 180, height: 180, crop: 'center' }}" alt="{{ item.title | escape }}" loading="lazy" width="80" height="80">
                  {% else %}
                    <div style="width:100%; height:100%; background:#f1f5f9;"></div>
                  {% endif %}
                </a>
              </div>

              <div class="cart-drawer__item-details">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title | escape }}</a>

                {% unless item.product.has_only_default_variant %}
                  <div class="cart-drawer__item-variant">{{ item.variant.title }}</div>
                {% endunless %}

                {% if item.properties != empty %}
                  <div class="cart-drawer__config-box">
                    <span class="cart-drawer__config-title">Configuration</span>
                    {% for property in item.properties %}
                      {% assign p_key = property.first %}
                      {% assign p_val = property.last %}
                      {% assign p_first_char = p_key | slice: 0, 1 %}
                      {% if p_val != blank and p_first_char != '_' %}
                        <div class="cart-drawer__config-row">
                          <strong>{{ p_key }}:</strong> {{ p_val }}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="cart-drawer__item-bottom">
                  <div class="cart-drawer__item-price">
                    {% assign item_config_price = item.properties['_configured_price'] %}
                    {% if item_config_price != blank %}
                      <span class="price-main">{{ item_config_price }}</span>
                      <span class="price-base">(Base: {{ item.final_line_price | money }})</span>
                    {% else %}
                      <span class="price-main">{{ item.final_line_price | money }}</span>
                    {% endif %}
                  </div>

                  <div class="cart-drawer__item-actions">
                    <div class="quantity-selector">
                      <button type="button" class="quantity-btn js-cart-qty-btn" data-action="decrease" data-key="{{ item.key }}" data-qty="{{ item.quantity }}">−</button>
                      <input type="number" class="quantity-input js-cart-qty-input" data-key="{{ item.key }}" value="{{ item.quantity }}" min="0" aria-label="Quantity">
                      <button type="button" class="quantity-btn js-cart-qty-btn" data-action="increase" data-key="{{ item.key }}" data-qty="{{ item.quantity }}">+</button>
                    </div>

                    <button type="button" class="cart-drawer__item-remove js-cart-remove" data-key="{{ item.key }}" aria-label="Remove item">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer" id="CartDrawerFooter">
        <div class="cart-drawer__footer-totals">
          <span class="cart-drawer__footer-label">Estimated Total</span>
          <span class="cart-drawer__footer-val">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-drawer__tax-note">Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="cart-drawer__checkout-btn">
            Check Out
          </button>
        </form>
      </div>
    {% endif %}
  </div>
</div>
