{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wholesale-enquiry-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.section_background }};
    padding: {{ section.settings.section_padding_desktop }}px 20px;
  }

  .ai-wholesale-enquiry-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 60px;
    align-items: start;
  }

  .ai-wholesale-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-wholesale-eyebrow-{{ ai_gen_id }} {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    font-weight: 600;
  }

  .ai-wholesale-heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-wholesale-intro-{{ ai_gen_id }} {
    color: {{ section.settings.text_color }};
    line-height: 1.6;
  }

  .ai-wholesale-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(47, 93, 80, 0.08);
  }

  .ai-wholesale-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-wholesale-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #E8DFD3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-wholesale-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-wholesale-trust-points-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-wholesale-trust-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    color: {{ section.settings.text_color }};
  }

  .ai-wholesale-trust-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    color: {{ section.settings.accent_color }};
    flex-shrink: 0;
  }

  .ai-wholesale-right-{{ ai_gen_id }} {
    background-color: {{ section.settings.form_background }};
    border-radius: {{ section.settings.form_border_radius }}px;
    padding: 40px;
    box-shadow: 0 2px 12px rgba(47, 93, 80, 0.06);
  }

  .ai-wholesale-form-heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.form_heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-wholesale-form-intro-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ section.settings.text_color }};
    margin-bottom: 28px;
    line-height: 1.5;
  }

  .ai-wholesale-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-wholesale-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .ai-wholesale-field-full-{{ ai_gen_id }} {
    grid-column: 1 / -1;
  }

  .ai-wholesale-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-wholesale-label-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
  }

  .ai-wholesale-required-{{ ai_gen_id }} {
    color: {{ section.settings.accent_color }};
    margin-left: 2px;
  }

  .ai-wholesale-input-{{ ai_gen_id }},
  .ai-wholesale-select-{{ ai_gen_id }},
  .ai-wholesale-textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 16px;
    font-size: 15px;
    color: {{ section.settings.input_text_color }};
    background-color: {{ section.settings.input_background }};
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_border_radius }}px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .ai-wholesale-input-{{ ai_gen_id }}::placeholder,
  .ai-wholesale-textarea-{{ ai_gen_id }}::placeholder {
    color: {{ section.settings.placeholder_color }};
  }

  .ai-wholesale-input-{{ ai_gen_id }}:focus,
  .ai-wholesale-select-{{ ai_gen_id }}:focus,
  .ai-wholesale-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 3px rgba(217, 164, 65, 0.1);
  }

  .ai-wholesale-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-wholesale-checkbox-group-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .ai-wholesale-checkbox-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-wholesale-checkbox-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: {{ section.settings.accent_color }};
    flex-shrink: 0;
  }

  .ai-wholesale-checkbox-label-{{ ai_gen_id }} {
    font-size: 15px;
    color: {{ section.settings.text_color }};
    cursor: pointer;
  }

  .ai-wholesale-location-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-wholesale-location-icon-{{ ai_gen_id }} {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: {{ section.settings.text_color }};
    opacity: 0.6;
  }

  .ai-wholesale-location-wrapper-{{ ai_gen_id }} .ai-wholesale-input-{{ ai_gen_id }} {
    padding-left: 42px;
  }

  .ai-wholesale-submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    font-size: 16px;
    font-weight: 600;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background }};
    border: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
    margin-top: 8px;
  }

  .ai-wholesale-submit-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_background }};
    transform: translateY(-1px);
  }

  .ai-wholesale-submit-{{ ai_gen_id }}:active {
    transform: translateY(0);
  }

  .ai-wholesale-success-{{ ai_gen_id }} {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }

  .ai-wholesale-success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-wholesale-success-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    background-color: {{ section.settings.accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .ai-wholesale-success-icon-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
  }

  .ai-wholesale-success-heading-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 12px 0;
  }

  .ai-wholesale-success-message-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .ai-wholesale-success-secondary-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 24px;
  }

  .ai-wholesale-back-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_background }};
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .ai-wholesale-back-button-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.button_hover_background }};
  }

  .ai-wholesale-error-{{ ai_gen_id }} {
    color: #D82C0D;
    font-size: 13px;
    margin-top: 4px;
    display: none;
  }

  .ai-wholesale-error-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-wholesale-enquiry-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-wholesale-right-{{ ai_gen_id }} {
      padding: 32px 24px;
    }

    .ai-wholesale-checkbox-group-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-wholesale-enquiry-{{ ai_gen_id }} {
      padding: {{ section.settings.section_padding_mobile }}px 16px;
    }

    .ai-wholesale-heading-{{ ai_gen_id }} {
      font-size: {{ section.settings.heading_size | times: 0.7 }}px;
    }

    .ai-wholesale-form-heading-{{ ai_gen_id }} {
      font-size: {{ section.settings.form_heading_size | times: 0.8 }}px;
    }

    .ai-wholesale-right-{{ ai_gen_id }} {
      padding: 28px 20px;
    }

    .ai-wholesale-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstyle %}

<wholesale-enquiry-{{ ai_gen_id }} class="ai-wholesale-enquiry-{{ ai_gen_id }}">
  <div class="ai-wholesale-enquiry-container-{{ ai_gen_id }}">
    <div class="ai-wholesale-left-{{ ai_gen_id }}">
      {% if section.settings.eyebrow != blank %}
        <div class="ai-wholesale-eyebrow-{{ ai_gen_id }}">{{ section.settings.eyebrow }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ai-wholesale-heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.intro_text != blank %}
        <div class="ai-wholesale-intro-{{ ai_gen_id }}">{{ section.settings.intro_text }}</div>
      {% endif %}

      <div class="ai-wholesale-image-wrapper-{{ ai_gen_id }}">
        {% if section.settings.image %}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            class="ai-wholesale-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-wholesale-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-wholesale-trust-points-{{ ai_gen_id }}">
        {% if section.settings.trust_point_1 != blank %}
          <div class="ai-wholesale-trust-item-{{ ai_gen_id }}">
            <svg class="ai-wholesale-trust-icon-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
            </svg>
            <span>{{ section.settings.trust_point_1 }}</span>
          </div>
        {% endif %}

        {% if section.settings.trust_point_2 != blank %}
          <div class="ai-wholesale-trust-item-{{ ai_gen_id }}">
            <svg class="ai-wholesale-trust-icon-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
            </svg>
            <span>{{ section.settings.trust_point_2 }}</span>
          </div>
        {% endif %}

        {% if section.settings.trust_point_3 != blank %}
          <div class="ai-wholesale-trust-item-{{ ai_gen_id }}">
            <svg class="ai-wholesale-trust-icon-{{ ai_gen_id }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/>
            </svg>
            <span>{{ section.settings.trust_point_3 }}</span>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-wholesale-right-{{ ai_gen_id }}">
      <div class="ai-wholesale-form-wrapper-{{ ai_gen_id }}">
        {% if section.settings.form_heading != blank %}
          <h3 class="ai-wholesale-form-heading-{{ ai_gen_id }}">{{ section.settings.form_heading }}</h3>
        {% endif %}

        {% if section.settings.form_intro != blank %}
          <p class="ai-wholesale-form-intro-{{ ai_gen_id }}">{{ section.settings.form_intro }}</p>
        {% endif %}

        {%- assign contact_form_id = 'contact-form-' | append: ai_gen_id -%}
        {%- form 'contact', id: contact_form_id -%}
          {%- if form.posted_successfully? -%}
            <div class="ai-wholesale-success-{{ ai_gen_id }} active">
              <div class="ai-wholesale-success-icon-{{ ai_gen_id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <h3 class="ai-wholesale-success-heading-{{ ai_gen_id }}">Thanks for getting in touch.</h3>
              <p class="ai-wholesale-success-message-{{ ai_gen_id }}">We've received your trade enquiry. We'll review your requirements and get back to you within 1 business day.</p>
              <p class="ai-wholesale-success-secondary-{{ ai_gen_id }}">We'll discuss product availability, delivery area, pricing and suitable ordering options.</p>
              <a href="{{ section.settings.back_link | default: '/' }}" class="ai-wholesale-back-button-{{ ai_gen_id }}">Back to Wholesale</a>
            </div>
          {%- else -%}
            <input type="hidden" name="contact[Enquiry Type]" value="B2B Wholesale Enquiry">
            <input type="hidden" name="contact[Products Interested In]" id="hidden-products-{{ ai_gen_id }}" value="">

            {%- if form.errors -%}
              <div class="ai-wholesale-error-{{ ai_gen_id }} active" style="margin-bottom: 20px; padding: 12px 16px; background-color: #fee2e2; border: 1px solid #ef4444; border-radius: 6px; color: #991b1b;">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="ai-wholesale-form-{{ ai_gen_id }}">
              <div class="ai-wholesale-form-grid-{{ ai_gen_id }}">
                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="business-name-{{ ai_gen_id }}">
                    Business Name<span class="ai-wholesale-required-{{ ai_gen_id }}">*</span>
                  </label>
                  <input
                    type="text"
                    id="business-name-{{ ai_gen_id }}"
                    name="contact[Business Name]"
                    class="ai-wholesale-input-{{ ai_gen_id }}"
                    placeholder="Your business name"
                    required
                  >
                </div>

                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="contact-name-{{ ai_gen_id }}">
                    Contact Name<span class="ai-wholesale-required-{{ ai_gen_id }}">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name-{{ ai_gen_id }}"
                    name="contact[name]"
                    class="ai-wholesale-input-{{ ai_gen_id }}"
                    placeholder="Your name"
                    required
                  >
                </div>

                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
                    Email Address<span class="ai-wholesale-required-{{ ai_gen_id }}">*</span>
                  </label>
                  <input
                    type="email"
                    id="email-{{ ai_gen_id }}"
                    name="contact[email]"
                    class="ai-wholesale-input-{{ ai_gen_id }}"
                    placeholder="you@business.com"
                    required
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="email-error-{{ ai_gen_id }}"
                    {% endif %}
                  >
                  {%- if form.errors contains 'email' -%}
                    <div id="email-error-{{ ai_gen_id }}" class="ai-wholesale-error-{{ ai_gen_id }} active">
                      {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                    </div>
                  {%- endif -%}
                </div>

                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">
                    Phone Number
                  </label>
                  <input
                    type="tel"
                    id="phone-{{ ai_gen_id }}"
                    name="contact[phone]"
                    class="ai-wholesale-input-{{ ai_gen_id }}"
                    placeholder="Your phone number"
                  >
                </div>

                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="business-type-{{ ai_gen_id }}">
                    Business Type<span class="ai-wholesale-required-{{ ai_gen_id }}">*</span>
                  </label>
                  <select
                    id="business-type-{{ ai_gen_id }}"
                    name="contact[Business Type]"
                    class="ai-wholesale-select-{{ ai_gen_id }}"
                    required
                  >
                    <option value="">Select your business type</option>
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'business_type' -%}
                        <option value="{{ block.settings.label }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>

                <div class="ai-wholesale-field-{{ ai_gen_id }}">
                  <label class="ai-wholesale-label-{{ ai_gen_id }}" for="location-{{ ai_gen_id }}">
                    Location / Postcode<span class="ai-wholesale-required-{{ ai_gen_id }}">*</span>
                  </label>
                  <div class="ai-wholesale-location-wrapper-{{ ai_gen_id }}">
                    <svg class="ai-wholesale-location-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <input
                      type="text"
                      id="location-{{ ai_gen_id }}"
                      name="contact[Location / Postcode]"
                      class="ai-wholesale-input-{{ ai_gen_id }}"
                      placeholder="Town or postcode"
                      required
                    >
                  </div>
                </div>
              </div>

              <div class="ai-wholesale-field-full-{{ ai_gen_id }}">
                <label class="ai-wholesale-label-{{ ai_gen_id }}">
                  Products Interested In
                </label>
                <div class="ai-wholesale-checkbox-group-{{ ai_gen_id }}">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'product' -%}
                      <div class="ai-wholesale-checkbox-item-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
                        <input
                          type="checkbox"
                          id="product-{{ ai_gen_id }}-{{ forloop.index }}"
                          name="contact[Product: {{ block.settings.label | escape }}]"
                          data-product-checkbox="{{ ai_gen_id }}"
                          value="Yes"
                          data-product-name="{{ block.settings.label | escape }}"
                          class="ai-wholesale-checkbox-{{ ai_gen_id }}"
                        >
                        <label for="product-{{ ai_gen_id }}-{{ forloop.index }}" class="ai-wholesale-checkbox-label-{{ ai_gen_id }}">{{ block.settings.label }}</label>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

              <div class="ai-wholesale-field-full-{{ ai_gen_id }}">
                <label class="ai-wholesale-label-{{ ai_gen_id }}" for="quantity-{{ ai_gen_id }}">
                  Estimated Weekly Quantity
                </label>
                <select
                  id="quantity-{{ ai_gen_id }}"
                  name="contact[Estimated Weekly Quantity]"
                  class="ai-wholesale-select-{{ ai_gen_id }}"
                >
                  <option value="">Select estimated quantity</option>
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'quantity' -%}
                      <option value="{{ block.settings.label }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>

              <div class="ai-wholesale-field-full-{{ ai_gen_id }}">
                <label class="ai-wholesale-label-{{ ai_gen_id }}" for="message-{{ ai_gen_id }}">
                  Additional Information
                </label>
                <textarea
                  id="message-{{ ai_gen_id }}"
                  name="contact[body]"
                  class="ai-wholesale-textarea-{{ ai_gen_id }}"
                  placeholder="Tell us about your requirements, preferred delivery schedule, or anything else you'd like us to know."
                ></textarea>
              </div>

              <div class="ai-wholesale-field-full-{{ ai_gen_id }}">
                <button type="submit" class="ai-wholesale-submit-{{ ai_gen_id }}">
                  {{ section.settings.button_text }}
                </button>
              </div>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</wholesale-enquiry-{{ ai_gen_id }}>

<script>
  (function() {
    function setupWholesaleForm_{{ ai_gen_id | replace: '-', '_' }}() {
      const sectionEl = document.getElementById('shopify-section-{{ section.id }}') || document.querySelector('.ai-wholesale-enquiry-{{ ai_gen_id }}');
      if (!sectionEl) return;

      const form = sectionEl.querySelector('form');
      const hiddenProducts = sectionEl.querySelector('#hidden-products-{{ ai_gen_id }}');
      const checkboxes = sectionEl.querySelectorAll('[data-product-checkbox="{{ ai_gen_id }}"]');

      function getSelectedProducts() {
        const selected = [];
        checkboxes.forEach(function(cb) {
          if (cb.checked) {
            selected.push(cb.getAttribute('data-product-name') || cb.value);
          }
        });
        return selected;
      }

      function updateHiddenProducts() {
        if (!hiddenProducts) return;
        const selected = getSelectedProducts();
        hiddenProducts.value = selected.length > 0 ? selected.join(', ') : 'None selected';
      }

      checkboxes.forEach(function(cb) {
        cb.addEventListener('change', updateHiddenProducts);
      });

      if (form) {
        form.addEventListener('submit', function() {
          updateHiddenProducts();
        });
      }

      updateHiddenProducts();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupWholesaleForm_{{ ai_gen_id | replace: '-', '_' }});
    } else {
      setupWholesaleForm_{{ ai_gen_id | replace: '-', '_' }}();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        setupWholesaleForm_{{ ai_gen_id | replace: '-', '_' }}();
      }
    });
  })();
</script>

