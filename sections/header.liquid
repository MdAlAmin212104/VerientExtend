<header class="header">
  <div class="header__left">
    <h1 class="header__logo">
      <a href="{{ routes.root_url }}">{{ shop.name }}</a>
    </h1>
  </div>

  <nav class="header__navigation" aria-label="Main Navigation">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" class="header__link {% if link.active %}header__link--active{% endif %}">
        {{ link.title }}
      </a>
    {% endfor %}
  </nav>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__account">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <button type="button" class="header__icon-btn header__cart-btn" data-cart-drawer-toggle aria-label="Cart ({{ cart.item_count }} items)">
      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="cart-count-badge" data-cart-count {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        {{ cart.item_count }}
      </span>
    </button>
  </div>
</header>

{% stylesheet %}
  .header {
    height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    padding: 0 1rem;
    background: #ffffff;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header__logo {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .header__logo a {
    color: var(--color-foreground, #111827);
    text-decoration: none;
  }
  .header__navigation {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .header__link {
    font-size: 0.95rem;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }
  .header__link:hover,
  .header__link--active {
    color: var(--color-foreground, #111827);
  }
  .header__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-foreground, #111827);
    transition: width 0.2s ease;
  }
  .header__link:hover::after,
  .header__link--active::after {
    width: 100%;
  }
  .header__icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header__icon-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground, #111827);
    border-radius: 50%;
    transition: background 0.2s ease;
  }
  .header__icon-btn:hover {
    background: var(--color-bg-subtle, #f9fafb);
  }
  .header__icon-btn svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  .cart-count-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--color-accent, #2563eb);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
    box-shadow: 0 0 0 2px #ffffff;
  }

  @media (max-width: 768px) {
    .header__navigation {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
