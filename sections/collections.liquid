{% comment %}
  Professional Collections List Section inspired by Shopify Dawn theme
{% endcomment %}

<div class="collections-list-section">
  <div class="collections-header">
    <h1 class="collections-header__title">{{ 'collections.title' | t | default: 'Our Collections' }}</h1>
    <p class="collections-header__subtitle">Explore our curated collections of premium products</p>
  </div>

  <div class="collections-grid {{ section.settings.grid_item_width }}" style="--grid-gap: {{ section.settings.grid_gap }}px">
    {% for collection in collections %}
      <a class="collection-item-card" href="{{ collection.url }}">
        <div class="collection-item-card__image-wrapper">
          {% if collection.featured_image %}
            <img src="{{ collection.featured_image | image_url: width: 800, height: 600, crop: 'center' }}" 
                 alt="{{ collection.title | escape }}" 
                 class="collection-item-card__image" 
                 width="400" height="300" loading="lazy">
          {% else %}
            <div class="collection-item-card__placeholder">
              <span>{{ collection.title | slice: 0, 1 }}</span>
            </div>
          {% endif %}
          <div class="collection-item-card__gradient-overlay"></div>
          
          <span class="collection-item-card__count-badge">{{ collection.all_products_count }} Products</span>
        </div>

        <div class="collection-item-card__content">
          <h2 class="collection-item-card__title">{{ collection.title }}</h2>

          {% if collection.description != blank %}
            <p class="collection-item-card__description">{{ collection.description | strip_html | truncatewords: 12 }}</p>
          {% endif %}

          <span class="collection-item-card__btn">
            Shop Collection 
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </span>
        </div>
      </a>
    {% else %}
      <div class="collections-empty">
        <p>No collections found.</p>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .collections-list-section {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .collections-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .collections-header__title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-foreground, #111827);
    margin-bottom: 0.5rem;
  }

  .collections-header__subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted, #6b7280);
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--grid-gap, 20px);
  }

  .collection-item-card {
    display: flex;
    flex-direction: column;
    position: relative;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-border, #e5e7eb);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .collection-item-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-xl);
  }

  .collection-item-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f1f5f9;
  }

  .collection-item-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-item-card:hover .collection-item-card__image {
    transform: scale(1.06);
  }

  .collection-item-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
    color: #ffffff;
    font-size: 3rem;
    font-weight: 800;
  }

  .collection-item-card__gradient-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.7) 0%, rgba(15, 23, 42, 0.1) 60%, transparent 100%);
  }

  .collection-item-card__count-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    color: var(--color-foreground, #111827);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    z-index: 2;
  }

  .collection-item-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1.5rem;
    z-index: 2;
    color: #ffffff;
    display: flex;
    flex-direction: column;
  }

  .collection-item-card__title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
    color: #ffffff;
  }

  .collection-item-card__description {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.85rem;
    line-height: 1.4;
  }

  .collection-item-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    transition: gap 0.2s ease;
  }

  .collection-item-card:hover .collection-item-card__btn {
    gap: 0.75rem;
    color: #93c5fd;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
