{% comment %}
  Professional Collection Page Section inspired by Shopify Dawn theme
{% endcomment %}

{% assign is_wholesale_customer = false %}
{% if customer and customer.tags contains 'wholesale' %}
  {% assign is_wholesale_customer = true %}
{% endif %}

{% assign hidden_wholesale_count = 0 %}
{% if is_wholesale_customer == false %}
  {% for prod in collection.products %}
    {% assign is_prod_wholesale = false %}
    {% assign wf_val = prod.metafields.custom.wholesale.value %}{% if wf_val == nil %}{% assign wf_val = prod.metafields.custom.wholesale %}{% endif %}
    {% if wf_val == true or wf_val == 'true' or prod.tags contains 'wholesale-only' or prod.tags contains 'wholesale' %}
      {% assign is_prod_wholesale = true %}
    {% endif %}

    {% if is_prod_wholesale %}
      {% assign hidden_wholesale_count = hidden_wholesale_count | plus: 1 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign total_customer_products_count = collection.products_count | minus: hidden_wholesale_count %}

<div class="collection-section">
  <!-- Hero Banner -->
  <header class="collection-hero {% if collection.image %}has-bg-image{% endif %}">
    {% if collection.image %}
      <div class="collection-hero__bg">
        <img src="{{ collection.image | image_url: width: 1600 }}" alt="{{ collection.title | escape }}" loading="eager">
        <div class="collection-hero__overlay"></div>
      </div>
    {% endif %}
    
    <div class="collection-hero__content">
      <h1 class="collection-title">
        {{ collection.title }}
        <span class="collection-count-badge">{{ total_customer_products_count }} Products</span>
      </h1>

      {% if collection.description != blank %}
        <div class="collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </header>

  <!-- Toolbar & Filters -->
  <div class="collection-toolbar">
    <div class="collection-toolbar__count">
      {% assign visible_products_count = 0 %}
      {% for product in collection.products %}
        {% assign is_prod_wholesale = false %}
        {% assign wf_val = product.metafields.custom.wholesale.value %}{% if wf_val == nil %}{% assign wf_val = product.metafields.custom.wholesale %}{% endif %}
        {% if wf_val == true or wf_val == 'true' or product.tags contains 'wholesale-only' or product.tags contains 'wholesale' %}
          {% assign is_prod_wholesale = true %}
        {% endif %}

        {% unless is_prod_wholesale and is_wholesale_customer == false %}
          {% assign visible_products_count = visible_products_count | plus: 1 %}
        {% endunless %}
      {% endfor %}
      Showing <strong>{{ visible_products_count }}</strong> of <strong>{{ total_customer_products_count }}</strong> items
    </div>

    <div class="collection-toolbar__sort">
      <label for="SortBy" class="sort-label">Sort by:</label>
      <div class="select-wrapper">
        <select name="sort_by" id="SortBy" class="sort-select">
          {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == current_sort %}selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
        </div>
    </div>
  </div>

  <!-- Products Grid -->
  {% paginate collection.products by 16 %}
    <div class="collection-products-grid">
      {% assign rendered_cards_count = 0 %}
      {% for product in collection.products %}
        {% assign is_prod_wholesale = false %}
        {% assign wf_val = product.metafields.custom.wholesale.value %}{% if wf_val == nil %}{% assign wf_val = product.metafields.custom.wholesale %}{% endif %}
        {% if wf_val == true or wf_val == 'true' or product.tags contains 'wholesale-only' or product.tags contains 'wholesale' %}
          {% assign is_prod_wholesale = true %}
        {% endif %}

        {% if is_prod_wholesale and is_wholesale_customer == false %}
          {% continue %}
        {% endif %}
        {% assign rendered_cards_count = rendered_cards_count | plus: 1 %}

        <div class="product-card">
          <div class="product-card__image-container">
            {% if is_prod_wholesale %}
              <span class="product-card__badge badge-wholesale">Wholesale Exclusive</span>
            {% endif %}
            {% unless product.available %}
              <span class="product-card__badge badge-sold-out" {% if is_prod_wholesale %}style="top: 2.5rem;"{% endif %}>Out of Stock</span>
            {% else %}
              {% if product.compare_at_price > product.price %}
                {% assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="product-card__badge badge-sale" {% if is_prod_wholesale %}style="top: 2.5rem;"{% endif %}>Save {{ discount }}%</span>
              {% endif %}
            {% endunless %}

            <a href="{{ product.url }}" class="product-card__image-link">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' }}" 
                     alt="{{ product.title | escape }}" 
                     class="product-card__image product-card__image--primary" 
                     width="300" height="300" loading="lazy">
                {% if product.images[1] %}
                  <img src="{{ product.images[1] | image_url: width: 600, height: 600, crop: 'center' }}" 
                       alt="{{ product.title | escape }}" 
                       class="product-card__image product-card__image--secondary" 
                       width="300" height="300" loading="lazy">
                {% endif %}
              {% else %}
                <div class="product-card__placeholder">No Image</div>
              {% endif %}
            </a>

            <!-- Quick Add to Cart Form or Configure Product CTA -->
            {% if product.available %}
              {% assign card_has_configurator = false %}
              {% if product.metafields.custom.configurator.value != blank %}
                {% assign card_config_meta = product.metafields.custom.configurator.value %}
                {% assign card_config_active = card_config_meta.active.value %}{% if card_config_active == nil %}{% assign card_config_active = card_config_meta.active %}{% endif %}
                {% unless card_config_active == false %}
                  {% assign card_has_configurator = true %}
                {% endunless %}
              {% endif %}

              {% if card_has_configurator %}
                <a href="{{ product.url }}" class="btn btn-secondary product-card__quick-add-btn" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">
                  <span>Configure Product</span>
                </a>
              {% else %}
                <form action="{{ routes.cart_url }}/add" method="post" class="product-card__quick-add-form">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="btn btn-primary product-card__quick-add-btn" aria-label="Add {{ product.title | escape }} to cart">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    <span>Quick Add</span>
                  </button>
                </form>
              {% endif %}
            {% else %}
              <button class="btn btn-secondary product-card__quick-add-btn" disabled>Out of Stock</button>
            {% endif %}
          </div>

          <div class="product-card__details">
            {% if product.vendor %}
              <span class="product-card__vendor">{{ product.vendor }}</span>
            {% endif %}
            
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            <div class="product-card__price-row">
              <span class="product-card__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <s class="product-card__compare-price">{{ product.compare_at_price | money }}</s>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}

      {% if rendered_cards_count == 0 %}
        <div class="collection-empty">
          <p>No products found in this collection.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse All Products</a>
        </div>
      {% endif %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div class="collection-pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-section {
    padding-top: 1rem;
    padding-bottom: 4rem;
  }

  /* Hero Header */
  .collection-hero {
    position: relative;
    padding: 3.5rem 2rem;
    border-radius: var(--radius-lg, 12px);
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: #ffffff;
    margin-bottom: 2.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .collection-hero.has-bg-image {
    background: transparent;
  }

  .collection-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .collection-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(2px);
  }

  .collection-hero__content {
    position: relative;
    z-index: 2;
    max-width: 650px;
  }

  .collection-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .collection-count-badge {
    font-size: 0.85rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;

  }

  .collection-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Toolbar */
  .collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    font-size: 0.9rem;
    color: var(--color-text-muted, #6b7280);
  }

  .collection-toolbar__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sort-label {
    font-weight: 600;
    color: var(--color-foreground, #111827);
  }

  .sort-select {
    padding: 0.5rem 2rem 0.5rem 0.85rem;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border, #e5e7eb);
    font-weight: 500;
    font-size: 0.875rem;
    background: #ffffff;
    cursor: pointer;
  }

  /* Product Cards Grid */
  .collection-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border, #e5e7eb);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .product-card__image-container {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f8fafc;
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.3s ease;
  }

  .product-card__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .product-card:hover .product-card__image--secondary {
    opacity: 1;
  }

  .product-card:hover .product-card__image--primary:has(+ .product-card__image--secondary) {
    opacity: 0;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    border-radius: 10px;
    padding: 4px 10px;
  }

  .badge-wholesale {
    background-color: #6366f1;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 4px rgba(99, 102, 241, 0.3);
  }

  .product-card__quick-add-form {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    z-index: 3;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
  }

  .product-card:hover .product-card__quick-add-form {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add-btn {
    width: 100%;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    border-radius: var(--radius-md, 8px);
    box-shadow: var(--shadow-md);
  }

  .product-card__details {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-card__vendor {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #2563eb);
    margin-bottom: 0.35rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.5rem;

  }

  .product-card__title a {
    color: var(--color-foreground, #111827);
  }

  .product-card__title a:hover {
    color: var(--color-accent, #2563eb);
  }

  .product-card__price-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }

  .product-card__price {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-foreground, #111827);
  }

  .product-card__compare-price {
    font-size: 0.9rem;
    color: #94a3b8;
  }

  /* Pagination */
  .collection-pagination {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }

  .collection-pagination .pagination {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .collection-pagination a,
  .collection-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--color-border, #e5e7eb);
    color: var(--color-foreground, #111827);
  }

  .collection-pagination span.current {
    background: var(--color-primary, #121212);
    color: #ffffff;
    border-color: var(--color-primary, #121212);
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sortBy = document.getElementById('SortBy');
    if (sortBy) {
      sortBy.addEventListener('change', function() {
        const urlParams = new URLSearchParams(window.location.search);
        urlParams.set('sort_by', this.value);
        window.location.search = urlParams.toString();
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
