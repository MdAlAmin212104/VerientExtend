{%- if section.blocks.size > 0 -%}
  <announcement-bar
    class="announcement-bar"
    data-auto-rotate="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
    style="
      --announcement-bar-bg: {{ section.settings.background_color }};
      --announcement-bar-text-color: {{ section.settings.text_color }};
    "
  >
    <div class="announcement-bar__container">
      <div class="announcement-bar__slider" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- assign block_id = block.id | default: forloop.index0 -%}
          {%- if block.settings.text != blank -%}
            <div
              class="announcement-bar__message{% if forloop.first %} is-active{% endif %}"
              data-block-id="{{ block_id }}"
              role="region"
              aria-label="Announcement {{ forloop.index }} of {{ section.blocks.size }}"
              {{ block.shopify_attributes }}
            >
              <div class="announcement-bar__content">
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="announcement-bar__link">
                    {{ block.settings.text }}
                  </a>
                {%- else -%}
                  <span class="announcement-bar__text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
              <button
                type="button"
                class="announcement-bar__dismiss"
                aria-label="Dismiss announcement"
                data-dismiss-id="{{ block_id }}"
              >
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M11 1L1 11M1 1L11 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </announcement-bar>

  <script>
    if (!customElements.get('announcement-bar')) {
      class AnnouncementBar extends HTMLElement {
        constructor() {
          super();
          this.STORAGE_KEY = 'dismissed_announcements';
          this.currentIndex = 0;
          this.timer = null;
        }

        connectedCallback() {
          this.init();
        }

        disconnectedCallback() {
          this.stopAutoRotate();
        }

        getDismissedIds() {
          try {
            const data = sessionStorage.getItem(this.STORAGE_KEY);
            return data ? JSON.parse(data) : [];
          } catch (e) {
            return [];
          }
        }

        saveDismissedId(id) {
          try {
            const dismissed = this.getDismissedIds();
            if (!dismissed.includes(id)) {
              dismissed.push(id);
              sessionStorage.setItem(this.STORAGE_KEY, JSON.stringify(dismissed));
            }
          } catch (e) {
            console.error('Could not save dismissed announcement', e);
          }
        }

        getActiveMessages() {
          return Array.from(this.querySelectorAll('.announcement-bar__message:not([data-dismissed="true"])'));
        }

        init() {
          const dismissedIds = this.getDismissedIds();
          const allMessages = this.querySelectorAll('.announcement-bar__message');

          allMessages.forEach((msg) => {
            const id = msg.getAttribute('data-block-id');
            if (dismissedIds.includes(id)) {
              msg.setAttribute('data-dismissed', 'true');
              msg.classList.remove('is-active');
            }
          });

          const activeMessages = this.getActiveMessages();

          if (activeMessages.length === 0) {
            this.style.display = 'none';
            return;
          }

          // Ensure only the first active message has is-active
          activeMessages.forEach((msg, idx) => {
            if (idx === 0) {
              msg.classList.add('is-active');
            } else {
              msg.classList.remove('is-active');
            }
          });

          this.currentIndex = 0;

          // Attach dismiss event listeners
          this.querySelectorAll('.announcement-bar__dismiss').forEach((btn) => {
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              const dismissId = btn.getAttribute('data-dismiss-id');
              this.dismissMessage(dismissId);
            });
          });

          // Pause auto-rotate on hover / focus
          this.addEventListener('mouseenter', () => this.stopAutoRotate());
          this.addEventListener('mouseleave', () => this.startAutoRotate());
          this.addEventListener('focusin', () => this.stopAutoRotate());
          this.addEventListener('focusout', () => this.startAutoRotate());

          // Theme editor listener
          if (window.Shopify && window.Shopify.designMode) {
            document.addEventListener('shopify:block:select', (e) => {
              const msg = this.querySelector(`[data-block-id="${e.detail.blockId}"]`);
              if (msg) {
                this.showSpecificMessage(msg);
              }
            });
          }

          this.startAutoRotate();
        }

        showSpecificMessage(targetMsg) {
          this.stopAutoRotate();
          const activeMessages = this.getActiveMessages();
          activeMessages.forEach((msg) => msg.classList.remove('is-active'));
          targetMsg.classList.add('is-active');
          this.currentIndex = activeMessages.indexOf(targetMsg);
        }

        dismissMessage(dismissId) {
          this.saveDismissedId(dismissId);

          const targetMsg = this.querySelector(`[data-block-id="${dismissId}"]`);
          if (!targetMsg) return;

          const activeMessagesBefore = this.getActiveMessages();
          const wasActive = targetMsg.classList.contains('is-active');

          targetMsg.setAttribute('data-dismissed', 'true');
          targetMsg.classList.remove('is-active');

          const activeMessagesAfter = this.getActiveMessages();

          if (activeMessagesAfter.length === 0) {
            this.stopAutoRotate();
            this.style.display = 'none';
            return;
          }

          if (wasActive) {
            let nextIndex = activeMessagesBefore.indexOf(targetMsg);
            if (nextIndex >= activeMessagesAfter.length) {
              nextIndex = 0;
            }
            this.currentIndex = nextIndex;
            activeMessagesAfter[this.currentIndex].classList.add('is-active');
          } else {
            const currentActiveMsg = this.querySelector('.announcement-bar__message.is-active');
            if (currentActiveMsg) {
              this.currentIndex = activeMessagesAfter.indexOf(currentActiveMsg);
            }
          }

          if (activeMessagesAfter.length <= 1) {
            this.stopAutoRotate();
          } else {
            this.startAutoRotate();
          }
        }

        rotateNext() {
          const activeMessages = this.getActiveMessages();
          if (activeMessages.length <= 1) return;

          activeMessages[this.currentIndex].classList.remove('is-active');
          this.currentIndex = (this.currentIndex + 1) % activeMessages.length;
          activeMessages[this.currentIndex].classList.add('is-active');
        }

        startAutoRotate() {
          this.stopAutoRotate();
          const autoRotate = this.getAttribute('data-auto-rotate') === 'true';
          const speed = parseInt(this.getAttribute('data-speed'), 10) || 5000;
          const activeMessages = this.getActiveMessages();

          if (autoRotate && activeMessages.length > 1) {
            this.timer = setInterval(() => this.rotateNext(), speed);
          }
        }

        stopAutoRotate() {
          if (this.timer) {
            clearInterval(this.timer);
            this.timer = null;
          }
        }
      }

      customElements.define('announcement-bar', AnnouncementBar);
    }
  </script>
{%- endif -%}

{% stylesheet %}
  announcement-bar {
    display: block;
    background-color: var(--announcement-bar-bg, #121212);
    color: var(--announcement-bar-text-color, #ffffff);
    font-size: 0.875rem;
    line-height: 1.4;
    position: relative;
    z-index: 10;
    overflow: hidden;
  }

  .announcement-bar__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 20px);
  }

  .announcement-bar__slider {
    position: relative;
    min-height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar__message {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.5rem 2.5rem;
    text-align: center;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out, transform 0.4s ease-in-out;
    transform: translateY(4px);
  }

  .announcement-bar__message.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .announcement-bar__message[data-dismissed="true"] {
    display: none !important;
  }

  .announcement-bar__content {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .announcement-bar__text,
  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .announcement-bar__link:hover {
    text-decoration: underline;
  }

  .announcement-bar__dismiss {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .announcement-bar__dismiss:hover {
    opacity: 1;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .announcement-bar__dismiss:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
    {
      "name": "Announcement bar",
      "max_blocks": 12,
      "class": "section-announcement-bar",
      "settings": [
        {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5,
      "visible_if": "{{ section.settings.auto_rotate }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Welcome to our store! Enjoy free shipping on orders over $50."
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New season styles have landed — Shop the collection today."
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Sign up for our newsletter to get 15% off your first purchase."
          }
        }
      ]
    }
  ]
}
{% endschema %}
