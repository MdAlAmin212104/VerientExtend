{% comment %}
  Professional Cart Page Section inspired by Shopify Dawn theme
{% endcomment %}

<div class="cart-page-section">
  <div class="cart-page-header">
    <h1 class="cart-page-title">
      {{ 'cart.title' | t | default: 'Your Shopping Cart' }}
      <span class="cart-page-count">({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
    </h1>
    <a href="{{ routes.all_products_collection_url }}" class="cart-continue-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Continue Shopping
    </a>
  </div>

  {% assign free_shipping_threshold = 10000 %}
  <div class="cart-page-shipping-bar">
    {% assign cart_total = cart.total_price %}
    {% if cart_total >= free_shipping_threshold %}
      <p class="shipping-bar__text shipping-bar__text--free">🎉 Congratulations! You've unlocked <strong>FREE Shipping!</strong></p>
      <div class="shipping-bar__progress-track"><div class="shipping-bar__progress-fill" style="width: 100%;"></div></div>
    {% else %}
      {% assign remaining = free_shipping_threshold | minus: cart_total %}
      <p class="shipping-bar__text">Add <strong>{{ remaining | money }}</strong> more to enjoy <strong>FREE Shipping</strong></p>
      {% assign percent = cart_total | times: 100 | divided_by: free_shipping_threshold %}
      <div class="shipping-bar__progress-track"><div class="shipping-bar__progress-fill" style="width: {{ percent }}%;"></div></div>
    {% endif %}
  </div>

  {% if cart.item_count == 0 %}
    <div class="cart-page-empty">
      <div class="cart-empty-icon-wrapper">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <h2>Your cart is currently empty</h2>
      <p>Before you check out, you must add some items to your shopping cart.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Start Shopping</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page-grid">
      <!-- Left Column: Items List -->
      <div class="cart-items-container">
        <div class="cart-table-header">
          <span class="col-product">Product</span>
          <span class="col-price">Price</span>
          <span class="col-quantity">Quantity</span>
          <span class="col-total">Total</span>
        </div>

        <div class="cart-items-list">
          {% for item in cart.items %}
            <div class="cart-item-row" data-line="{{ forloop.index }}">
              <div class="col-product cart-item-info">
                <a href="{{ item.url }}" class="cart-item-image-link">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 240, height: 240, crop: 'center' }}" alt="{{ item.title | escape }}" width="100" height="100" loading="lazy">
                  {% else %}
                    <div class="cart-item-placeholder"></div>
                  {% endif %}
                </a>

                <div class="cart-item-details">
                  {% if item.product.vendor %}
                    <span class="cart-item-vendor">{{ item.product.vendor }}</span>
                  {% endif %}

                  <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>

                  {% unless item.product.has_only_default_variant %}
                    <span class="cart-item-variant">{{ item.variant.title }}</span>
                  {% endunless %}

                  {% if item.properties != empty %}
                    <div class="cart-item__configuration" style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:0.65rem 0.85rem; margin:0.4rem 0 0.65rem; max-width:380px;">
                      <span class="cart-item__config-title" style="display:block; font-size:0.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; color:#334155; margin-bottom:0.35rem;">
                        Configuration
                      </span>
                      <div class="cart-item__config-list" style="display:flex; flex-direction:column; gap:0.25rem; font-size:0.825rem; color:#0f172a; line-height:1.45;">
                        {% for property in item.properties %}
                          {% assign p_key = property.first %}
                          {% assign p_val = property.last %}
                          {% assign p_first_char = p_key | slice: 0, 1 %}
                          {% if p_val != blank and p_first_char != '_' %}
                            <div class="cart-item__config-item">
                              <strong style="color:#0f172a;">{{ p_key }}:</strong> {{ p_val }}
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}

                  <a href="{{ item.url_to_remove }}" class="cart-item-remove-link">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    Remove
                  </a>
                </div>
              </div>

              {% assign configured_unit_price = item.properties['Configured Unit Price'] | default: item.properties['Configured Price'] %}
              <div class="col-price cart-item-price-col">
                {% if configured_unit_price != blank %}
                  <span class="cart-item-price" style="font-weight: 800; color: #111827;">{{ configured_unit_price }}</span>
                  <div style="font-size:0.75rem; color:#6b7280;">(Base Variant: {{ item.final_price | money }})</div>
                {% else %}
                  <span class="cart-item-price">{{ item.final_price | money }}</span>
                  {% if item.original_price > item.final_price %}
                    <s class="cart-item-original-price">{{ item.original_price | money }}</s>
                  {% endif %}
                {% endif %}
              </div>

              <div class="col-quantity cart-item-quantity-col">
                <div class="quantity-selector">
                  <button type="button" class="quantity-btn js-cart-page-qty-btn" data-action="decrease" data-line="{{ forloop.index }}">−</button>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="quantity-input js-cart-page-qty-input">
                  <button type="button" class="quantity-btn js-cart-page-qty-btn" data-action="increase" data-line="{{ forloop.index }}">+</button>
                </div>
              </div>

              <div class="col-total cart-item-total-col">
                {% if configured_unit_price != blank %}
                  <span class="cart-item-line-total" style="font-weight: 800; color: #111827;">
                    {% assign price_val = configured_unit_price | remove: '$' | remove: ',' | plus: 0 %}
                    {% if price_val > 0 %}
                      {% assign line_total = price_val | times: item.quantity %}
                      ${{ line_total | number_with_delimiter }}
                    {% else %}
                      {{ configured_unit_price }}
                    {% endif %}
                  </span>
                {% else %}
                  <span class="cart-item-line-total">{{ item.final_line_price | money }}</span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-items-actions">
          <div class="cart-note-container">
            <label for="CartSpecialInstructions" class="cart-note-label">Special instructions for order</label>
            <textarea name="note" id="CartSpecialInstructions" class="cart-note-input" rows="3" placeholder="How can we help you with your order?">{{ cart.note }}</textarea>
          </div>

          <div class="cart-update-wrapper">
            <button type="submit" name="update" class="btn btn-secondary">Update Cart</button>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Summary Card -->
      <div class="cart-summary-card">
        <h2 class="cart-summary-title">Order Summary</h2>

        <div class="cart-summary-rows">
          <div class="summary-row">
            <span>Subtotal</span>
            <span class="summary-price">{{ cart.total_price | money }}</span>
          </div>

          {% if cart.total_discounts > 0 %}
            <div class="summary-row summary-row--discount">
              <span>Total Savings</span>
              <span>-{{ cart.total_discounts | money }}</span>
            </div>
          {% endif %}

          <div class="summary-row">
            <span>Shipping</span>
            <span class="summary-subtext">{% if cart_total >= free_shipping_threshold %}FREE{% else %}Calculated at checkout{% endif %}</span>
          </div>

          <div class="summary-row">
            <span>Tax</span>
            <span class="summary-subtext">Calculated at checkout</span>
          </div>
        </div>

        <div class="cart-summary-divider"></div>

        <div class="summary-row summary-row--total">
          <span>Estimated Total</span>
          <span class="summary-total-price">{{ cart.total_price | money }}</span>
        </div>

        <button type="submit" name="checkout" class="btn btn-primary btn-full cart-checkout-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Proceed to Checkout
        </button>

        <p class="cart-security-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Safe & Secure 256-Bit SSL Encrypted Checkout
        </p>

        <!-- Payment Methods Icons -->
        <div class="cart-payment-icons">
          <span class="payment-icon">Visa</span>
          <span class="payment-icon">Mastercard</span>
          <span class="payment-icon">Amex</span>
          <span class="payment-icon">PayPal</span>
          <span class="payment-icon">Apple Pay</span>
        </div>
      </div>
    </form>
  {% endif %}
</div>

{% stylesheet %}
  .cart-page-section {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .cart-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cart-page-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-page-count {
    color: var(--color-text-muted, #6b7280);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .cart-continue-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-accent, #2563eb);
    text-decoration: none;
  }

  .cart-continue-link:hover {
    text-decoration: underline;
  }

  /* Free Shipping Bar */
  .cart-page-shipping-bar {
    padding: 1rem 1.5rem;
    background: #f8fafc;
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-border, #e5e7eb);
    margin-bottom: 2.5rem;
  }

  .cart-page-shipping-bar .shipping-bar__text {
    font-size: 0.95rem;
    color: #334155;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .cart-page-shipping-bar .shipping-bar__text--free {
    color: #15803d;
  }

  .cart-page-shipping-bar .shipping-bar__progress-track {
    height: 8px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .cart-page-shipping-bar .shipping-bar__progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #3b82f6);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  /* Empty State */
  .cart-page-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    text-align: center;
    background: #ffffff;
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .cart-empty-icon-wrapper {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-bg-subtle, #f9fafb);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  .cart-page-empty h2 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .cart-page-empty p {
    color: var(--color-text-muted, #6b7280);
    margin-bottom: 2rem;
  }

  /* Cart Layout Grid */
  .cart-page-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 2.5rem;
    align-items: start;
  }

  .cart-items-container {
    background: #ffffff;
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-border, #e5e7eb);
    overflow: hidden;
  }

  .cart-table-header {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1.2fr 1fr;
    padding: 1rem 1.5rem;
    background: var(--color-bg-subtle, #f9fafb);
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #6b7280);
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
  }

  .cart-item-row {
    display: grid;
    grid-template-columns: 2.5fr 1fr 1.2fr 1fr;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .cart-item-row:last-child {
    border-bottom: none;
  }

  .cart-item-info {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .cart-item-image-link {
    width: 90px;
    height: 90px;
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .cart-item-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-details {
    display: flex;
    flex-direction: column;
  }

  .cart-item-vendor {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent, #2563eb);
    margin-bottom: 0.25rem;
  }

  .cart-item-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-foreground, #111827);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .cart-item-title:hover {
    color: var(--color-accent, #2563eb);
  }

  .cart-item-variant {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6b7280);
    margin-bottom: 0.5rem;
  }

  .cart-item-remove-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ef4444;
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .cart-item-remove-link:hover {
    text-decoration: underline;
  }

  .cart-item-price-col {
    display: flex;
    flex-direction: column;
  }

  .cart-item-price {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-foreground, #111827);
  }

  .cart-item-original-price {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .cart-item-line-total {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-foreground, #111827);
  }

  .cart-items-actions {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 1.5rem;
    background: var(--color-bg-subtle, #f9fafb);
    border-top: 1px solid var(--color-border, #e5e7eb);
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cart-note-container {
    flex: 1;
    min-width: 250px;
  }

  .cart-note-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .cart-note-input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-md, 8px);
    font-size: 0.9rem;
    background: #ffffff;
    resize: vertical;
  }

  /* Summary Card */
  .cart-summary-card {
    background: #ffffff;
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-border, #e5e7eb);
    padding: 1.75rem;
    position: sticky;
    top: 6rem;
    box-shadow: var(--shadow-sm);
  }

  .cart-summary-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--color-foreground, #111827);
  }

  .cart-summary-rows {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.95rem;
    color: #4b5563;
  }

  .summary-row--discount {
    color: #16a34a;
    font-weight: 600;
  }

  .summary-price {
    font-weight: 700;
    color: var(--color-foreground, #111827);
  }

  .summary-subtext {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6b7280);
  }

  .cart-summary-divider {
    height: 1px;
    background: var(--color-border, #e5e7eb);
    margin: 1.25rem 0;
  }

  .summary-row--total {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-foreground, #111827);
    margin-bottom: 1.5rem;
  }

  .summary-total-price {
    font-size: 1.4rem;
    color: var(--color-accent, #2563eb);
  }

  .cart-checkout-btn {
    padding: 1rem 1.5rem;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .cart-security-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    color: var(--color-text-muted, #6b7280);
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .cart-payment-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .payment-icon {
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    background: #f1f5f9;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
  }

  @media (max-width: 960px) {
    .cart-page-grid {
      grid-template-columns: 1fr;
    }

    .cart-table-header {
      display: none;
    }

    .cart-item-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .cart-item-price-col,
    .cart-item-quantity-col,
    .cart-item-total-col {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .cart-item-price-col::before {
      content: 'Price:';
      font-weight: 600;
      font-size: 0.9rem;
    }

    .cart-item-quantity-col::before {
      content: 'Quantity:';
      font-weight: 600;
      font-size: 0.9rem;
    }

    .cart-item-total-col::before {
      content: 'Total:';
      font-weight: 600;
      font-size: 0.9rem;
    }
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Cart page quantity controls
    document.querySelectorAll('.js-cart-page-qty-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const action = this.dataset.action;
        const line = this.dataset.line;
        const input = document.querySelector(`.js-cart-page-qty-input[name="updates[]"]:nth-of-type(${line})`) || this.parentElement.querySelector('input');
        
        if (input) {
          let currentVal = parseInt(input.value, 10) || 1;
          if (action === 'increase') {
            input.value = currentVal + 1;
          } else if (action === 'decrease' && currentVal > 0) {
            input.value = currentVal - 1;
          }
          // Optionally submit form automatically on quantity change
          const form = document.getElementById('CartPageForm');
          if (form) form.submit();
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
